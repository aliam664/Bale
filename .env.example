# توکن بازو را از @botfather در بله بگیرید (https://ble.ir/botfather)
BALE_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آدرس پایهٔ API (معمولاً نیازی به تغییر نیست)
BALE_API_BASE=https://tapi.bale.ai

# ثانیه؛ مدت انتظار Long Polling در getUpdates
POLL_TIMEOUT=30
# ثانیه؛ حداکثر زمان هر نوبت (بعد از آن بازیکن می‌بازد)
TURN_TIMEOUT=120
# ثانیه؛ حداکثر انتظار در صف حریف
QUEUE_TIMEOUT=180
# ثانیه؛ مکث «فکر کردن» کامپیوتر (0 = بدون مکث)
CPU_DELAY=0.7
# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
